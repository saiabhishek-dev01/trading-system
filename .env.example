# Copy to .env on the trading machine. Never commit .env or paste these into chat.
# Zerodha Kite Connect app (https://developers.kite.trade): API key + secret.
# Set the app's redirect URL to your dashboard address, e.g. http://127.0.0.1:8501/
KITE_API_KEY=
KITE_API_SECRET=
# Real orders are only sent when this is exactly "yes".
LIVE_TRADING_ENABLED=no
# Optional Telegram alerts (@BotFather token, your chat id)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
